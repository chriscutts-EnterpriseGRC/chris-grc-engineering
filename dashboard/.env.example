# ─── Supabase (required for live data) ───────────────────────────────────────
# Create a free project at https://supabase.com, then copy these from
# Project Settings → API
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Integrations (optional — enable one at a time) ──────────────────────────
# Leave blank to keep using demo data for that module.

# Jira → Incidents
JIRA_HOST=https://yourorg.atlassian.net
JIRA_EMAIL=you@yourorg.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC

# Qualys → Vulnerabilities
QUALYS_API_URL=https://qualysapi.qg2.apps.qualys.com
QUALYS_USERNAME=
QUALYS_PASSWORD=

# Splunk → Incidents
SPLUNK_HOST=https://your-splunk-host:8089
SPLUNK_TOKEN=

# AWS Security Hub → Vulnerabilities
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ServiceNow → Incidents / Policy
SERVICENOW_INSTANCE=https://yourorg.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=
