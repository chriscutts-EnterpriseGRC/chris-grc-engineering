# ─── LLM Gateway Configuration ───────────────────────────────────────────────

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Model pinning — change here to roll out a new model version across all callers
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# Auth — Supabase JWT secret (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Service token for non-user callers (integration adapters, MCP server)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_SERVICE_TOKEN=

# Rate limiting (per caller, sliding window)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Server
PORT=3100
NODE_ENV=production

# Prompt injection — set to "block" to reject, "flag" to allow through but audit
PROMPT_INJECTION_ACTION=block
